
# Ephemeral multi-agent research findings (not product artifacts)
.research/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Python bytecode
__pycache__/
*.pyc

# Agent runtime artifacts (hook-required derived copies; not authoritative)
.agent/

# Machine-local Claude Code config; shared advisors and routing live under jixia/
.claude/

# Serena LSP cache (per-machine)
.serena/

# Local gate-signal log (per-machine hook output)
.beads/.gate-signal.jsonl
# bd worktree
.worktrees/

# Plugin ZIP for workspace uploads (bin/build-plugin)
/dist/
